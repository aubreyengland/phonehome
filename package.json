{
  "name": "phone-provisioning-inventory",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed": "node scripts/build-seed.ts",
    "seed:apply": "wrangler d1 execute phone_provisioning --remote --file seed/expected_devices.sql",
    "seed:apply:local": "wrangler d1 execute phone_provisioning --local --file seed/expected_devices.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@types/node": "^22.20.3",
    "fflate": "^0.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}
